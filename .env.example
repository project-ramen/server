# 포트·호스트 (선택)
# PORT=3000
# HOST=localhost

# PostgreSQL 연결 문자열 (필수)
# DATABASE_URL=postgresql://user:pass@localhost:5432/ramen

# (구버전) 파일시스템 RxDB 데이터 — migrate/ 스크립트로만 사용
# RAMEN_DATA_DIR=./data

# 관리자 API 비밀번호. 설정 시 포스트·리비전 등 관리자 API에
# Authorization: Bearer <이 값> 헤더 필요. 앱 연결 시 블로그 설정에서 같은 비밀번호 입력.
# RAMEN_ADMIN_PASSWORD=

# CORS 허용 오리진 (쉼표 구분). credentials 사용 시 필요.
# CORS_ORIGIN=http://localhost:5173,http://localhost:1420,http://localhost:4321

# 웹 빌드 정적 서빙 경로 (Docker 등 단일 이미지 배포 시)
# WEB_DIST_DIR=./web-dist
